# Copy this file to .env and fill in the blanks:
#     Windows : copy .env.example .env
#     macOS   : cp .env.example .env
#
# .env is gitignored. Never put a real value in THIS file — it is committed.

# --- Database --------------------------------------------------------------
# Must match the credentials in docker-compose.yml. Use 127.0.0.1, not
# "localhost": on some Windows PCs "localhost" makes every new connection
# wait about 20 seconds (it tries IPv6 first).
DATABASE_URL=postgresql+psycopg://cinematch:cinematch@127.0.0.1:5432/cinematch

# --- TMDB ------------------------------------------------------------------
# Your own API Read Access Token from https://www.themoviedb.org/settings/api
# Each developer uses their own. Never share one in the group chat.
TMDB_API_TOKEN=
TMDB_BASE=https://api.themoviedb.org/3
IMAGE_BASE=https://image.tmdb.org/t/p

# --- Login / tokens --------------------------------------------------------
# Generate your own:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding this value can forge a login token for any user.
JWT_SECRET=
JWT_ALGORITHM=HS256
TOKEN_HOURS=24

# --- Google sign-in (optional) ----------------------------------------------
# The OAuth client ID of a "Web application" client from Google Cloud. It is
# not a secret, but keep it here, not in the code. Empty = Google sign-in off.
GOOGLE_CLIENT_ID=

# --- Cache -----------------------------------------------------------------
# How long a cached TMDB answer stays fresh, in hours (used by get_or_fetch).
CACHE_HOURS=6

# --- App -------------------------------------------------------------------
# Where the React dev server runs. The backend refuses browser requests
# from any origin not listed here.
CORS_ORIGINS=http://localhost:5173
